# Supabase — leave unset to run in demo mode (in-memory seed data, no auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider: "anthropic" | "openai" | leave unset to disable AI features
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Secret shared with cron/scheduled jobs that hit /api/ingest and /api/verify
JOBSIGNAL_CRON_SECRET=
